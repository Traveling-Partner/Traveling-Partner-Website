# Preferred API base (includes /api)
NEXT_PUBLIC_API_URL=https://api.traveling-partner.com/api

# Backward-compatible legacy base (without /api)
# NEXT_PUBLIC_API_BASE_URL=http://45.55.78.67:8080

# Optional: where next dev proxies /website-api (default matches backend)
# BACKEND_ORIGIN=http://45.55.78.67:8080

# Vercel (HTTPS): if an HTTP base is set, the app falls back to
# /website-api/* → vercel.json proxies to Spring (avoids mixed content).
