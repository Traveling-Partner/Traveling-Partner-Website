# Preferred API base (includes /api) — should point at your **Spring API host**
# (e.g. api subdomain), not at https://www.traveling-partner.com/website-api
NEXT_PUBLIC_API_BASE_URL=https://api.traveling-partner.com/api

# Backward-compatible legacy base (without /api)
# NEXT_PUBLIC_API_BASE_URL=http://45.55.78.67:8080

# Optional: where next dev proxies /website (default matches backend)
# BACKEND_ORIGIN=http://45.55.78.67:8080

# Vercel (HTTPS): if an HTTP base is set, the app falls back to
# /website/* → vercel.json proxies to Spring (avoids mixed content).

# Production tip: the browser should call same-origin `/website/blog/list`
# (rewritten to Spring). If NEXT_PUBLIC_API_* accidentally uses the **same origin**
# as the public site, the app now ignores it in the browser and still uses `/website/*`.
