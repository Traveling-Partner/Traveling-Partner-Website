# Local development: browser → backend HTTP (allowed from localhost)
NEXT_PUBLIC_API_BASE_URL=http://45.55.78.67:8080

# Optional: where next dev proxies /website-api (default matches backend)
# BACKEND_ORIGIN=http://45.55.78.67:8080

# Vercel production: do NOT set NEXT_PUBLIC_API_BASE_URL (or set it empty).
# Deploy uses vercel.json rewrite: /website-api/* → your Spring server (HTTPS page → same-origin fetch).
