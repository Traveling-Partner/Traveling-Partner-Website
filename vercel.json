{
  "redirects": [
    {
      "source": "/taxi-stand",
      "destination": "/taxi-ride",
      "permanent": true
    },
    {
      "source": "/taxi-stand/",
      "destination": "/taxi-ride",
      "permanent": true
    },
    {
      "source": "/trip",
      "destination": "/tourism",
      "permanent": true
    },
    {
      "source": "/trip/",
      "destination": "/tourism",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/website/:path*",
      "destination": "https://staging.api.traveling-partner.com/api/website/:path*"
    },
    {
      "source": "/ride-location/:token",
      "destination": "/ride-location?shareToken=:token"
    }
  ]
}
