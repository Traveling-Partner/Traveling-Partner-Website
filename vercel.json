{
  "redirects": [
    {
      "source": "/taxi-stand",
      "destination": "/taxi-ride",
      "permanent": true
    },
    {
      "source": "/taxi-stand/",
      "destination": "/taxi-ride",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/website/:path*",
      "destination": "https://staging.api.traveling-partner.com/api/website/:path*"
    },
    {
      "source": "/ride-location/:token",
      "destination": "/ride-location?shareToken=:token"
    }
  ]
}
